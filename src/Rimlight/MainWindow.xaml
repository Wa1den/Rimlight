<Window x:Class="Rimlight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rimlight" Height="870" Width="1400" MinWidth="1317" MinHeight="820"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- left rail: app identity on top, sections below -->
        <Grid Grid.Column="0" Width="216" Margin="6,12,6,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="14,2,8,16">
                <Image Source="pack://application:,,,/icon.ico" Width="20" Height="20"
                       VerticalAlignment="Center"/>
                <TextBlock Text="Rimlight" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Fg}" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <ListBox x:Name="Nav" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="Margin" Value="0,1"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- settings page for the selected section -->
        <Grid Grid.Column="1" Margin="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource Fg}" Margin="2,0,0,12"/>

            <ContentControl x:Name="PageHost" Grid.Row="1"/>

            <Border x:Name="DirtyBar" Grid.Row="2" Style="{StaticResource Card}"
                    Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Padding="14,6" Margin="8,0,0,0"/>
                    <Button x:Name="ApplyButton" DockPanel.Dock="Right" Padding="14,6"/>
                    <TextBlock x:Name="DirtyText" Foreground="{StaticResource Warn}" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- preview and status -->
        <Grid Grid.Column="2" Margin="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewCaption" Grid.Row="0" Foreground="{StaticResource FgDim}"
                               FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Canvas x:Name="PreviewCanvas" Grid.Row="1" ClipToBounds="True"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="StatsText" Foreground="{StaticResource Fg}"
                               FontFamily="Cascadia Mono,Consolas" FontSize="12"/>
                    <TextBlock x:Name="WarnText" Foreground="{StaticResource Warn}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
