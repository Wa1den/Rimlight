<Window x:Class="LatencyProbe.BenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пробник задержки" Height="640" Width="780"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True">
    <DockPanel Margin="10">

        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Монитор:" Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="MonitorBox" Width="320" VerticalAlignment="Center"/>
                    <TextBlock Text="Интервал, с:" Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="20,0,8,0"/>
                    <TextBox x:Name="IntervalBox" Text="3" Width="50" VerticalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="GridButton" Content="Вывести сетку" Padding="12,5"/>
                    <Button x:Name="StartButton" Content="Старт" Margin="16,0,0,0" Padding="20,5"/>
                    <Button x:Name="StopButton" Content="Стоп" Margin="8,0,0,0" Padding="20,5" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="ClockText" Text="0.000" Foreground="{StaticResource Fg}"
                           FontFamily="Consolas, Courier New" FontSize="56" FontWeight="Bold"/>
                <TextBlock x:Name="FrameText" Text="кадр 0" Foreground="{StaticResource Fg}"
                           FontFamily="Consolas, Courier New" FontSize="22" Margin="0,2,0,0"/>
                <TextBlock x:Name="StepText" Text="остановлено" Foreground="{StaticResource FgDim}"
                           FontSize="13" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ConfigText" DockPanel.Dock="Top" Foreground="{StaticResource FgDim}"
                   FontSize="11" TextWrapping="Wrap" Margin="2,0,2,4"/>
        <TextBlock x:Name="WarnText" DockPanel.Dock="Top" Foreground="{StaticResource Warn}"
                   FontSize="11" TextWrapping="Wrap" Margin="2,0,2,8"/>

        <TextBlock x:Name="LogPathText" DockPanel.Dock="Bottom" Foreground="{StaticResource FgDim}"
                   FontSize="11" Margin="2,8,2,0"/>

        <ListBox x:Name="Events" Background="{StaticResource Panel}" Foreground="{StaticResource Fg}"
                 BorderThickness="0" FontFamily="Consolas, Courier New" FontSize="13"/>
    </DockPanel>
</Window>
