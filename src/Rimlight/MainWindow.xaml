<Window x:Class="Rimlight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rimlight" Height="870" Width="1400" MinWidth="1317" MinHeight="820"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- The bar is kept out of the column grid on purpose. Spanned across the columns
             its own width becomes a claim on them, and the first column is auto-sized: one
             long status line would stretch that column until the settings page hung off
             the right edge. Docked here it takes what the window has, no more. -->
        <DockPanel x:Name="StatusBar" DockPanel.Dock="Bottom" Margin="12,0,12,8">
            <!-- One button rather than two: at any moment only one of a pair would do
                 anything. MinWidth keeps the caption change from shifting the status line
                 sideways, «Стоп» being the shorter word. -->
            <Button x:Name="OutputButton" DockPanel.Dock="Left" Padding="12,5" MinWidth="88"/>

            <!-- One line always: a message with a port name in it would otherwise wrap and
                 lift the whole bar, and the bar moving about under the buttons is worse
                 than a tail behind an ellipsis. The full text is in the tooltip. -->
            <TextBlock x:Name="StatusText" Foreground="{StaticResource FgDim}" FontSize="14"
                       VerticalAlignment="Center" Margin="12,0,12,0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- the width is repeated as MainWindow.PageWidth, which adds up the compact
                     window width; the two have to stay in step -->
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- left rail: the section list, sized by its longest caption; the preview
                 toggle sits at the bottom because the preview belongs to no one section -->
            <DockPanel x:Name="Rail" Grid.Column="0" Margin="6,12,6,12">
                <CheckBox x:Name="PreviewToggle" DockPanel.Dock="Bottom" Margin="12,12,8,2"
                          Foreground="{StaticResource Fg}"/>
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                         VerticalAlignment="Top"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="12,9"/>
                            <Setter Property="Margin" Value="0,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <!-- settings page for the selected section -->
            <Grid Grid.Column="1" Margin="0,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ContentControl x:Name="PageHost" Grid.Row="0"/>

                <!-- a new release is an offer, not a fault, so it gets a card of its own
                     rather than a line in the status bar, which the next tick would take
                     away -->
                <Border x:Name="UpdateCard" Grid.Row="1" Style="{StaticResource Card}"
                        Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <!-- dismissal lives for the session only: the check runs at startup,
                             so the next cold start is what brings the notice back -->
                        <Button x:Name="UpdateClose" DockPanel.Dock="Right"
                                FontFamily="{StaticResource Icons}" FontSize="10" Content="&#xE711;"
                                Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0"/>
                        <TextBlock x:Name="UpdateText" FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border x:Name="DirtyBar" Grid.Row="2" Style="{StaticResource Card}"
                        Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="CancelButton" DockPanel.Dock="Right" Padding="14,6" Margin="8,0,0,0"/>
                        <Button x:Name="ApplyButton" DockPanel.Dock="Right" Padding="14,6"/>
                        <TextBlock x:Name="DirtyText" Foreground="{StaticResource Warn}" FontSize="14"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- preview and statistics -->
            <Grid x:Name="RightColumn" Grid.Column="2" Margin="0,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Canvas x:Name="PreviewCanvas" ClipToBounds="True"/>
                </Border>

                <Border x:Name="StatsCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid x:Name="StatsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
