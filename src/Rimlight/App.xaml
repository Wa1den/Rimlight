<Application x:Class="Rimlight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ThemeMode="System">
    <Application.Resources>
        <!-- Semantic aliases over the Fluent theme colour tokens. DynamicResource on the
             Colour keeps every brush following the system light/dark switch at runtime. -->
        <SolidColorBrush x:Key="Fg" Color="{DynamicResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="FgDim" Color="{DynamicResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="Warn" Color="{DynamicResource SystemFillColorCaution}" />
        <SolidColorBrush x:Key="Panel" Color="{DynamicResource CardBackgroundFillColorDefault}" />
        <SolidColorBrush x:Key="PanelStroke" Color="{DynamicResource CardStrokeColorDefault}" />

        <!-- Outline of a preview cell. Lighter than PanelStroke, which is meant for a card
             edge against the window background: over the captured frame and over the LED
             colours themselves that one is too close to what it lies on to be seen. -->
        <SolidColorBrush x:Key="CellStroke" Color="{DynamicResource ControlStrokeColorSecondary}" />

        <FontFamily x:Key="Icons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
    </Application.Resources>
</Application>
