<Window x:Class="Ambilight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ambilight" Height="870" Width="1317" MinWidth="1317" MinHeight="870"
        Background="{StaticResource Bg}" UseLayoutRounding="True">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="Tabs" Grid.Row="0"
                        Background="{StaticResource Bg}" BorderBrush="#3A3A42"/>

            <Border x:Name="DirtyBar" Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="6"
                    Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Padding="12,4" Margin="6,0,0,0"/>
                    <Button x:Name="ApplyButton" DockPanel.Dock="Right" Padding="12,4"/>
                    <TextBlock x:Name="DirtyText" Foreground="{StaticResource Warn}" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewCaption" Grid.Row="0" Foreground="{StaticResource FgDim}"
                               FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Canvas x:Name="PreviewCanvas" Grid.Row="1" ClipToBounds="True"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="6" Padding="14" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="StatsText" Foreground="{StaticResource Fg}"
                               FontFamily="Consolas" FontSize="12"/>
                    <TextBlock x:Name="WarnText" Foreground="{StaticResource Warn}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
