<Application x:Class="Ambilight.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1E1E22" />
        <SolidColorBrush x:Key="Panel" Color="#2A2A30" />
        <SolidColorBrush x:Key="Fg" Color="#E8E8EC" />
        <SolidColorBrush x:Key="FgDim" Color="#B4B4BE" />
        <SolidColorBrush x:Key="Warn" Color="#D8B45A" />

        <!-- No implicit TextBlock style: WPF renders combo box items with TextBlock too,
             and a light foreground there lands on the system's white popup. Foreground is
             set explicitly on the text we create instead. -->
    </Application.Resources>
</Application>
