<Window x:Class="Rimlight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rimlight" Height="870" Width="1400" MinWidth="1317" MinHeight="820"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>
    <DockPanel x:Name="Root">
        <!-- The status line is kept out of the column grid on purpose. Spanned across the
             columns its own width becomes a claim on them, and the first column is
             auto-sized: one long status line would stretch that column until the settings
             page hung off the right edge. Docked here it takes what the window has, no more.

             One line always: a message with a port name in it would otherwise wrap and lift
             the columns above it. The full text is in the tooltip. -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="12,0,12,8"
                   Foreground="{StaticResource FgDim}" FontSize="14"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- the width is repeated as MainWindow.PageWidth, which adds up the compact
                     window width; the two have to stay in step -->
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The title bar is the first row of the same grid, so what stands in it lines
                 up with the column below: the program name over the sections, the output
                 over the page, the preview switches over the preview. Its height is
                 MainWindow.TitleHeight. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- поле рейла 6 плюс отступ пункта списка 12: логотип стоит над значками
                 разделов, название над их подписями -->
            <StackPanel x:Name="TitleName" Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="18,0,12,0">
                <Image x:Name="TitleLogo" Width="16" Height="16" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Rimlight" Foreground="{StaticResource Fg}" FontSize="12"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Everything in the title bar drags the window except what is marked; the mark
                 is inherited, so it goes on the panels. -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- One button rather than two: at any moment only one of a pair would do
                     anything. MinWidth keeps the caption change from shifting the checkbox
                     beside it, «Стоп» being the shorter word. -->
                <Button x:Name="OutputButton" Padding="12,5" MinWidth="88"/>
                <CheckBox x:Name="PreviewToggle" Margin="16,0,0,0" MinWidth="0"
                          Foreground="{StaticResource Fg}"/>
            </StackPanel>

            <!-- ways of looking at the preview, hidden along with it; the right margin keeps
                 them clear of the caption buttons and is set in code -->
            <StackPanel x:Name="PreviewTools" Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>

            <!-- left rail: the section list, sized by its longest caption -->
            <DockPanel x:Name="Rail" Grid.Row="1" Grid.Column="0" Margin="6,12,6,12">
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                         VerticalAlignment="Top"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="12,9"/>
                            <Setter Property="Margin" Value="0,1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <!-- settings page for the selected section -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ContentControl x:Name="PageHost" Grid.Row="0"/>

                <!-- Second home for the statistics, for when they are not under the zone
                     map. A row of the column rather than the last thing on the Capture page:
                     inside the page it scrolled away with the settings, and the numbers
                     are watched while the settings above them are being turned. -->
                <Border x:Name="StatsHost" Grid.Row="1" Style="{StaticResource Card}"
                        Margin="0,10,0,0" Visibility="Collapsed"/>

                <!-- a new release is an offer, not a fault, so it gets a card of its own
                     rather than a line in the status bar, which the next tick would take
                     away -->
                <Border x:Name="UpdateCard" Grid.Row="2" Style="{StaticResource Card}"
                        Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <!-- dismissal lives for the session only: the check runs at startup,
                             so the next cold start is what brings the notice back -->
                        <Button x:Name="UpdateClose" DockPanel.Dock="Right"
                                FontFamily="{StaticResource Icons}" FontSize="10" Content="&#xE711;"
                                Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0"/>
                        <TextBlock x:Name="UpdateText" FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Border x:Name="DirtyBar" Grid.Row="3" Style="{StaticResource Card}"
                        Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="CancelButton" DockPanel.Dock="Right" Padding="14,6" Margin="8,0,0,0"/>
                        <Button x:Name="ApplyButton" DockPanel.Dock="Right" Padding="14,6"/>
                        <TextBlock x:Name="DirtyText" Foreground="{StaticResource Warn}" FontSize="14"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- preview and statistics -->
            <Grid x:Name="RightColumn" Grid.Row="1" Grid.Column="2" Margin="0,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Canvas x:Name="PreviewCanvas" ClipToBounds="True"/>
                </Border>

                <Border x:Name="StatsCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid x:Name="StatsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
