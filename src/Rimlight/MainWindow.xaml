<Window x:Class="Rimlight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rimlight" Height="870" Width="1400" MinWidth="1317" MinHeight="820"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- left rail: the section list, sized by its longest caption; the preview
             toggle sits at the bottom because the preview belongs to no one section -->
        <DockPanel Grid.Column="0" Margin="6,12,6,12">
            <CheckBox x:Name="PreviewToggle" DockPanel.Dock="Bottom" Margin="12,12,8,2"
                      Foreground="{StaticResource Fg}"/>
            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Top"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="Margin" Value="0,1"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- settings page for the selected section -->
        <Grid Grid.Column="1" Margin="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="PageHost" Grid.Row="0"/>

            <!-- warnings live with the settings, not the preview, so hiding the preview
                 cannot hide a dead port -->
            <Border x:Name="WarnCard" Grid.Row="1" Style="{StaticResource Card}"
                    Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="WarnText" Foreground="{StaticResource Warn}" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <Border x:Name="DirtyBar" Grid.Row="2" Style="{StaticResource Card}"
                    Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Padding="14,6" Margin="8,0,0,0"/>
                    <Button x:Name="ApplyButton" DockPanel.Dock="Right" Padding="14,6"/>
                    <TextBlock x:Name="DirtyText" Foreground="{StaticResource Warn}" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- preview and status -->
        <Grid x:Name="RightColumn" Grid.Column="2" Margin="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Canvas x:Name="PreviewCanvas" ClipToBounds="True"/>
            </Border>

            <Border x:Name="StatsCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid x:Name="StatsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
